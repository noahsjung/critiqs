{
  "name": "critiqs",
  "version": "0.3.0",
  "description": "Critiqs for any web app: comment on an interactive prototype, discuss feedback, and find its context. Framework packages build on this one.",
  "license": "MIT",
  "keywords": [
    "feedback",
    "comments",
    "review",
    "prototype",
    "design review",
    "web component"
  ],
  "homepage": "https://github.com/noahsjung/critiqs/tree/main/packages/critiqs#readme",
  "bugs": {
    "url": "https://github.com/noahsjung/critiqs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./cli": {
      "types": "./bin/cli.d.mts",
      "import": "./bin/cli.mjs"
    }
  },
  "sideEffects": [
    "./dist/element.js"
  ],
  "bin": {
    "critiqs": "./bin/critiqs.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --isolate",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "check:consumer": "bun scripts/check-consumer.ts && bun scripts/check-two-documents.ts"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "modern-screenshot": "^4.6.0",
    "@critiqs/core": "workspace:*",
    "@critiqs/backend": "workspace:*",
    "@critiqs/server": "workspace:*"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "AGENT_SETUP.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noahsjung/critiqs.git",
    "directory": "packages/critiqs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
