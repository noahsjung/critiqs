{
  "name": "critiqs-solid",
  "version": "0.3.0",
  "description": "Critiqs for Solid and SolidStart: add <Critiqs /> to a prototype to comment on it, discuss feedback, and find its context.",
  "license": "MIT",
  "keywords": [
    "solid",
    "solidjs",
    "solid-start",
    "solid-router",
    "feedback",
    "comments",
    "review",
    "prototype",
    "design review"
  ],
  "homepage": "https://github.com/noahsjung/critiqs/tree/main/packages/solid#readme",
  "bugs": {
    "url": "https://github.com/noahsjung/critiqs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "solid": "./dist/router.js",
      "import": "./dist/router.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --isolate --conditions=browser",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build",
    "check:consumer": "bun scripts/check-consumer.ts"
  },
  "dependencies": {
    "critiqs": "0.3.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0 || ^2.0.0",
    "@solidjs/router": ">=0.15.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "solid-js": "^2.0.4",
    "solid-js-1": "npm:solid-js@1.9.20",
    "@solidjs/router": "^2.0.1",
    "solid-router-1": "npm:@solidjs/router@1.0.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/web": "^2.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noahsjung/critiqs.git",
    "directory": "packages/solid"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
