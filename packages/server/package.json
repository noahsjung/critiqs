{
  "name": "@critiqs/server",
  "version": "0.0.0",
  "private": true,
  "description": "Critiqs's server rules: who may do what, validation, and limits, shared by every backend (Convex, or SQLite in the host app's server).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./http": "./src/http/index.ts",
    "./public-web": "./src/public-web.ts",
    "./review-links": "./src/review-links.ts",
    "./review-directory": "./src/review-directory.ts",
    "./review-builds": "./src/review-builds.ts",
    "./contract": "./test/contract.ts",
    "./ai-providers": "./src/ai/providers.ts",
    "./contract-ai": "./test/contract-ai.ts",
    "./contract-onboarding": "./test/contract-onboarding.ts",
    "./contract-addresses": "./test/contract-addresses.ts",
    "./contract-tickets": "./test/contract-tickets.ts",
    "./contract-ticket-links": "./test/contract-ticket-links.ts",
    "./contract-ticket-drafts": "./test/contract-ticket-drafts.ts",
    "./contract-ticket-status": "./test/contract-ticket-status.ts",
    "./linear-standin": "./test/linear-standin.ts",
    "./github-standin": "./test/github-standin.ts",
    "./jira-standin": "./test/jira-standin.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test && node --experimental-transform-types --no-warnings --test test/address-pinning.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/gateway": "4.0.152",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@critiqs/core": "workspace:*",
    "ai": "7.0.179",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5"
  }
}
