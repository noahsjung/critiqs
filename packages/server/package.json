{
  "name": "@critiqs/server",
  "version": "0.0.0",
  "private": true,
  "description": "Critiqs's server rules: who may do what, validation, and limits, shared by every backend (Convex, or SQLite in the host app's server).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./http": "./src/http/index.ts",
    "./contract": "./test/contract.ts",
    "./ai-providers": "./src/ai/providers.ts",
    "./contract-ai": "./test/contract-ai.ts",
    "./contract-onboarding": "./test/contract-onboarding.ts",
    "./contract-addresses": "./test/contract-addresses.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test && node --experimental-transform-types --no-warnings --test test/address-pinning.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.106",
    "@ai-sdk/gateway": "4.0.150",
    "@ai-sdk/google": "4.0.122",
    "@ai-sdk/openai": "4.0.121",
    "@ai-sdk/openai-compatible": "3.0.93",
    "@critiqs/core": "workspace:*",
    "ai": "7.0.177",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
