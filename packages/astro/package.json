{
  "name": "critiqs-astro",
  "version": "0.5.0",
  "description": "Critiqs for Astro: an integration that adds Critiqs to every page, to comment on a prototype, discuss feedback, and find its context.",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "feedback",
    "comments",
    "review",
    "prototype",
    "design review"
  ],
  "homepage": "https://github.com/noahsjung/critiqs/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/noahsjung/critiqs/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --isolate",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "check:consumer": "bun scripts/check-consumer.ts"
  },
  "dependencies": {
    "critiqs": "0.5.0"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.5",
    "astro": "^7.4.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noahsjung/critiqs.git",
    "directory": "packages/astro"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
