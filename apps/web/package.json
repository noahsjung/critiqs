{
  "name": "@critiqs/web",
  "version": "0.0.0",
  "private": true,
  "description": "The Critiqs website's app: onboarding at /start, the developer's setup page at /setup/<id>, and thread pages at /t/<key>.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "vite build --base=/app/ --outDir ../../site/app --emptyOutDir",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@critiqs/backend": "workspace:*",
    "@critiqs/core": "workspace:*",
    "convex": "^1.51.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.4"
  }
}
